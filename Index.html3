<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Aryan Verma — Software Developer Intern</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,400;8..60,600;8..60,700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#FFFDF8;
    --panel:#F7EAE8;
    --panel-2:#F2DFDC;
    --peach:#C97B84;
    --peach-deep:#B15D6B;
    --sage:#A9BBA3;
    --slate:#8B8577;
    --text-dark:#2E2A22;
    --text-soft:#5B5647;

    --coral:#E8735F;
    --coral-bg:#FDECE7;
    --teal:#1E8C7A;
    --teal-bg:#E4F4EE;
    --violet:#8B5FBF;
    --violet-bg:#F1E9FA;
    --gold:#D9A02B;
    --gold-bg:#FCF2DC;
    --blue:#3E7CB1;
    --blue-bg:#E7F1FA;
    --pink:#D6537F;
    --pink-bg:#FBE7EF;
    --serif: 'Source Serif 4', serif;
    --sans: 'Inter', sans-serif;
    --mono: 'JetBrains Mono', monospace;
  }
  *{margin:0;padding:0;box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    font-family:var(--sans);
    background:linear-gradient(180deg,
      #FDECE7 0%,
      #FCF2DC 16%,
      #F1E9FA 32%,
      #E7F1FA 48%,
      #E4F4EE 64%,
      #FBE7EF 82%,
      #FDECE7 100%);
    background-attachment:fixed;
    color:var(--text-dark);
    line-height:1.6;
  }
  a{color:inherit;}
  .wrap{max-width:760px;margin:0 auto;padding:0 28px;}

  /* ---------- HERO ---------- */
  .hero{
    position:relative;
    padding:96px 0 68px;
    background:transparent;
  }
  .kicker{
    font-family:var(--mono);
    font-size:13px;
    color:var(--coral);
    letter-spacing:0.02em;
    margin-bottom:18px;
    font-weight:600;
  }
  h1{
    font-family:var(--serif);
    font-weight:600;
    font-size:clamp(2.4rem, 6vw, 3.4rem);
    color:var(--text-dark);
    line-height:1.08;
    max-width:9ch;
  }
  .role{
    font-size:1.05rem;
    color:var(--text-soft);
    margin-top:14px;
    max-width:44ch;
  }
  .contact-row{
    display:flex;
    flex-wrap:wrap;
    gap:10px;
    margin-top:34px;
  }
  .contact-row a, .contact-row span{
    font-family:var(--mono);
    font-size:12.5px;
    color:var(--text-dark);
    background:#fff;
    padding:8px 14px;
    border-radius:20px;
    text-decoration:none;
    white-space:nowrap;
  }
  .contact-row a:hover{background:var(--coral); color:#fff;}

  /* ---------- SECTION SHELL ---------- */
  section{padding:52px 0;}
  .section-label{
    font-family:var(--mono);
    font-size:12px;
    margin-bottom:8px;
    font-weight:600;
  }
  #summary .section-label{color:var(--coral);}
  #skills .section-label{color:var(--teal);}
  #project .section-label{color:var(--violet);}
  #education .section-label{color:var(--blue);}
  #more .section-label{color:var(--gold);}
  h2{
    font-family:var(--serif);
    font-weight:600;
    font-size:1.6rem;
    color:var(--text-dark);
    margin-bottom:26px;
  }

  /* ---------- SUMMARY ---------- */
  #summary p{
    max-width:62ch;
    color:var(--text-soft);
    font-size:1.02rem;
  }

  /* ---------- SKILLS ---------- */
  .skill-groups{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:20px;
  }
  .skill-group{
    background:#fff;
    border-radius:16px;
    padding:20px 22px;
    border-left:5px solid var(--teal);
    box-shadow:0 4px 14px rgba(0,0,0,0.05);
  }
  .skill-group:nth-child(2){border-left-color:var(--pink);}
  .skill-group:nth-child(3){border-left-color:var(--gold);}
  .skill-group:nth-child(4){border-left-color:var(--blue);}
  .skill-group h3{
    font-family:var(--mono);
    font-size:12px;
    color:var(--teal);
    text-transform:lowercase;
    margin-bottom:14px;
    font-weight:600;
  }
  .skill-group:nth-child(2) h3{color:var(--pink);}
  .skill-group:nth-child(3) h3{color:var(--gold);}
  .skill-group:nth-child(4) h3{color:var(--blue);}
  .skill-group ul{list-style:none;}
  .skill-group li{
    font-family:var(--mono);
    font-size:13.5px;
    color:var(--text-dark);
    padding:5px 0;
  }

  /* ---------- PROJECT CARD ---------- */
  .ticket{
    background:#fff;
    border-radius:20px;
    display:grid;
    grid-template-columns:1fr auto;
    overflow:hidden;
    box-shadow:0 6px 20px rgba(0,0,0,0.06);
  }
  .ticket-main{padding:30px 30px 26px;}
  .ticket-stub{
    background:var(--violet);
    color:#fff;
    padding:30px 24px;
    display:flex;
    flex-direction:column;
    justify-content:space-between;
    min-width:160px;
  }
  .ticket-title{
    font-family:var(--serif);
    font-weight:600;
    font-size:1.35rem;
    margin-bottom:6px;
    color:var(--text-dark);
  }
  .ticket-stack{
    font-family:var(--mono);
    font-size:12px;
    color:var(--violet);
    margin-bottom:16px;
    font-weight:600;
  }
  .ticket-main ul{
    padding-left:18px;
    font-size:14.5px;
    color:var(--text-soft);
  }
  .ticket-main li{margin-bottom:8px;}
  .stub-label{font-family:var(--mono); font-size:10.5px; color:#F1E9FA; letter-spacing:0.04em;}
  .stub-value{font-family:var(--mono); font-size:12.5px; color:#fff; margin-top:3px;}
  .stub-line{margin-bottom:16px;}
  .stub-link{
    font-family:var(--mono);
    font-size:12px;
    color:#fff;
    text-decoration:none;
    font-weight:500;
  }

  /* ---------- EDUCATION TIMELINE ---------- */
  .timeline-item{
    display:grid;
    grid-template-columns:90px 1fr;
    gap:18px;
    padding:16px 20px;
    border-radius:14px;
    margin-bottom:10px;
    background:#fff;
    border-left:5px solid var(--blue);
    box-shadow:0 4px 14px rgba(0,0,0,0.05);
  }
  .t-year{
    font-family:var(--mono);
    font-size:12.5px;
    color:var(--blue);
    font-weight:600;
  }
  .t-title{font-weight:600; color:var(--text-dark); font-size:1rem;}
  .t-sub{color:var(--text-soft); font-size:13.5px; margin-top:3px;}
  .t-meta{color:var(--slate); font-size:13px; margin-top:6px; font-family:var(--mono);}

  /* ---------- CERT + ACHIEVEMENT ---------- */
  .flag-row{display:flex; flex-direction:column; gap:14px;}
  .flag{
    display:flex; gap:14px; align-items:flex-start;
    padding:18px 20px;
    background:#fff;
    border-radius:14px;
    border-left:5px solid var(--gold);
    box-shadow:0 4px 14px rgba(0,0,0,0.05);
  }
  .flag:nth-child(2){border-left-color:var(--coral);}
  .flag:nth-child(3){border-left-color:var(--teal);}
  .flag-mark{
    font-family:var(--mono); color:var(--gold); font-size:13px; margin-top:2px; font-weight:700;
  }
  .flag-title{font-weight:600; font-size:15px; color:var(--text-dark);}
  .flag-sub{color:var(--text-soft); font-size:13px; margin-top:2px;}

  /* ---------- LANGUAGES ---------- */
  .lang-row{display:flex; gap:32px; margin-top:4px;}
  .lang{font-family:var(--mono); font-size:13px; color:var(--text-dark);}
  .lang span{color:var(--slate);}

  /* ---------- FOOTER ---------- */
  footer{
    background:var(--pink);
    color:#fff;
    padding:56px 0 48px;
    text-align:left;
    margin-top:20px;
  }
  footer h2{color:#fff;}
  footer .section-label{color:#FBE7EF;}
  footer p{color:#FBE7EF; max-width:50ch; margin-bottom:24px; font-size:14.5px;}
  .footer-links{display:flex; flex-wrap:wrap; gap:10px;}
  .footer-links a{
    font-family:var(--mono);
    font-size:12.5px;
    color:#fff;
    background:rgba(255,255,255,0.2);
    padding:9px 16px;
    border-radius:20px;
    text-decoration:none;
  }
  .footer-links a:hover{background:#fff; color:var(--pink);}
  .footer-note{margin-top:26px; font-size:12px; color:#FBE7EF; font-family:var(--mono);}

  @media (max-width:600px){
    .skill-groups{grid-template-columns:1fr;}
    .ticket{grid-template-columns:1fr;}
    .ticket-stub{flex-direction:row; flex-wrap:wrap; gap:20px;}
    .timeline-item{grid-template-columns:1fr;}
  }

  @media (prefers-reduced-motion: reduce){
    html{scroll-behavior:auto;}
  }
</style>
</head>
<body>

  <div class="hero">
    <div class="wrap">
      <div class="kicker">Software Developer Intern</div>
      <h1>Aryan Verma</h1>
      <p class="role">B.Tech CSE (AI &amp; ML) student building a foundation in Java, OOP, and software development fundamentals — looking for an internship where I can learn fast and ship real work.</p>
      <div class="contact-row">
        <span>Lucknow, Uttar Pradesh, India</span>
        <a href="mailto:aryanverma6520@gmail.com">aryanverma6520@gmail.com</a>
        <a href="tel:+919026638445">+91 90266 38445</a>
        <a href="https://linkedin.com/in/aryan-verma-5360a2415" target="_blank" rel="noopener">linkedin.com/in/aryan-verma-5360a2415</a>
        <a href="https://github.com/av7170393-ctrl" target="_blank" rel="noopener">github.com/av7170393-ctrl</a>
      </div>
    </div>
  </div>

  <section id="summary">
    <div class="wrap">
      <div class="section-label">Summary</div>
      <h2>About</h2>
      <p>I'm a first-year Computer Science &amp; Engineering (AI &amp; ML) student with a strong foundation in Core Java and object-oriented programming, built through structured training and a hands-on project. I use Git and GitHub for version control, and I've been developing my prompt engineering skills alongside my core programming work. I'm looking to grow as an intern inside a collaborative software development team.</p>
    </div>
  </section>

  <section id="skills">
    <div class="wrap">
      <div class="section-label">Skills</div>
      <h2>Technical skills</h2>
      <div class="skill-groups">
        <div class="skill-group">
          <h3>languages</h3>
          <ul>
            <li>Java</li>
            <li>C</li>
          </ul>
        </div>
        <div class="skill-group">
          <h3>concepts</h3>
          <ul>
            <li>Object-Oriented Programming</li>
            <li>File Handling</li>
          </ul>
        </div>
        <div class="skill-group">
          <h3>tools &amp; platforms</h3>
          <ul>
            <li>Git</li>
            <li>GitHub</li>
            <li>IntelliJ IDEA</li>
          </ul>
        </div>
        <div class="skill-group">
          <h3>other</h3>
          <ul>
            <li>Prompt Engineering</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section id="project">
    <div class="wrap">
      <div class="section-label">Major Project</div>
      <h2>Project</h2>
      <div class="ticket">
        <div class="ticket-main">
          <div class="ticket-title">Railway Reservation System</div>
          <div class="ticket-stack">Core Java, OOP, File Handling</div>
          <ul>
            <li>Built a Railway Reservation System in Core Java, applying object-oriented principles for structured, modular code.</li>
            <li>Implemented file handling to manage and persist reservation data.</li>
            <li>Designed and built the application end-to-end, strengthening core programming and problem-solving skills.</li>
          </ul>
        </div>
        <div class="ticket-stub">
          <div>
            <div class="stub-line">
              <div class="stub-label">STATUS</div>
              <div class="stub-value">Complete</div>
            </div>
            <div class="stub-line">
              <div class="stub-label">TYPE</div>
              <div class="stub-value">Console App</div>
            </div>
          </div>
          <a class="stub-link" href="https://github.com/av7170393-ctrl" target="_blank" rel="noopener">View on GitHub →</a>
        </div>
      </div>
    </div>
  </section>

  <section id="education">
    <div class="wrap">
      <div class="section-label">Education</div>
      <h2>Education</h2>

      <div class="timeline-item">
        <div class="t-year">2025 —<br>2029</div>
        <div>
          <div class="t-title">B.Tech, Computer Science &amp; Engineering (AI &amp; ML)</div>
          <div class="t-sub">RR Institution of Modern Technology, Dr. A.P.J. Abdul Kalam Technical University (AKTU)</div>
          <div class="t-meta">Sem 1 SGPA: 7.68, Sem 2 SGPA: 7.32</div>
        </div>
      </div>

      <div class="timeline-item">
        <div class="t-year">—</div>
        <div>
          <div class="t-title">Class XII, Senior Secondary</div>
          <div class="t-sub">United Avadh Inter College, Mahmudabad, Sitapur</div>
          <div class="t-meta">75.86%</div>
        </div>
      </div>

      <div class="timeline-item">
        <div class="t-year">—</div>
        <div>
          <div class="t-title">Class X, Secondary</div>
          <div class="t-sub">United Avadh Inter College, Mahmudabad, Sitapur</div>
          <div class="t-meta">75.67%</div>
        </div>
      </div>
    </div>
  </section>

  <section id="more">
    <div class="wrap">
      <div class="section-label">Training &amp; Recognition</div>
      <h2>Training, certification &amp; achievement</h2>
      <div class="flag-row">
        <div class="flag">
          <div class="flag-mark">TR</div>
          <div>
            <div class="flag-title">40-Day Core Java Training</div>
            <div class="flag-sub">Structured program covering OOP fundamentals — classes, objects, inheritance, polymorphism — plus file handling through hands-on exercises.</div>
          </div>
        </div>
        <div class="flag">
          <div class="flag-mark">CT</div>
          <div>
            <div class="flag-title">LLM for Young Developers: Foundational Course</div>
            <div class="flag-sub">Certification</div>
          </div>
        </div>
        <div class="flag">
          <div class="flag-mark">AC</div>
          <div>
            <div class="flag-title">Silver Medal for 99.04% Attendance</div>
            <div class="flag-sub">Achievement</div>
          </div>
        </div>
      </div>

      <div style="margin-top:32px;">
        <div class="section-label" style="margin-bottom:10px;">languages</div>
        <div class="lang-row">
          <div class="lang">Hindi <span>(Fluent)</span></div>
          <div class="lang">English <span>(Basic)</span></div>
        </div>
      </div>
    </div>
  </section>

  <footer id="contact">
    <div class="wrap">
      <div class="section-label">Get In Touch</div>
      <h2>Let's talk</h2>
      <p>I'm actively looking for a software development internship. If you have a role where a fast-learning Java developer would be useful, I'd love to hear from you.</p>
      <div class="footer-links">
        <a href="mailto:aryanverma6520@gmail.com">Email me</a>
        <a href="https://linkedin.com/in/aryan-verma-5360a2415" target="_blank" rel="noopener">LinkedIn</a>
        <a href="https://github.com/av7170393-ctrl" target="_blank" rel="noopener">GitHub</a>
        <a href="tel:+919026638445">Call</a>
      </div>
      <div class="footer-note">Lucknow, Uttar Pradesh, India</div>
    </div>
  </footer>

</body>
</html>
